{
  "name": "claudian-desktop",
  "productName": "Claudian",
  "version": "0.18.0",
  "private": true,
  "description": "Claudian ortak hafıza uygulaması",
  "author": "Claudian",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run smoke",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win nsis --x64",
    "smoke": "electron . --smoke",
    "test:unit": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.claudian.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "grants.cjs",
      "codex-grant.cjs",
      "management.cjs",
      "companion.cjs",
      "assets/icon.ico",
      "smoke.cjs",
      "ui/**/*",
      "licenses/**/*",
      "package.json",
      "welcome.cjs",
      "obsidian.cjs",
      "upgrade.cjs",
      "notice.cjs",
      "watch.cjs",
      "policy.cjs",
      "probe.cjs",
      "roles.cjs",
      "starter.cjs",
      "policies/**/*",
      "scan.cjs",
      "companion-bridge.cjs",
      "mcp.cjs",
      "memory-capabilities.cjs",
      "memory-store.cjs",
      "memory-runtime.cjs",
      "memory-hook.cjs",
      "claude-lifecycle.cjs",
      "codex-connector.cjs",
      "mcp-hosts.cjs",
      "mcp-server.cjs",
      "connector-upgrade.cjs",
      "connection-test.cjs",
      "setup-review.cjs",
      "remote-auth.cjs",
      "remote-http.cjs",
      "remote-connector.cjs",
      "connector-package.cjs",
      "memory-capture.cjs",
      "first-review.cjs"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "displayLanguageSelector": true,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Claudian-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  }
}
